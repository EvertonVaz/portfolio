{
	"name": "Portfolio",
	"dockerComposeFile": [
		"../docker-compose.yml",
		"docker-compose.yml"
	],
	"service": "dev",
	"remoteUser": "${localEnv:USER}",
	"workspaceFolder": "${localWorkspaceFolder}",
	"customizations": {
		"vscode": {
			"extensions": [
				"cweijan.vscode-database-client2",
				"bradlc.vscode-tailwindcss",
				"naumovs.color-highlight",
				"jakebecker.elixir-ls",
				"ms-python.python",
				"ms-python.black-formatter"
			]
		}
	}
}
