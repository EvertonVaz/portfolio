# ─── Backend Elixir (Phoenix) ─────────────────────────────────────────
PORT=4000
# >= 64 bytes; abaixo disso cai no fallback de dev (em prod dá raise). Gere: mix phx.gen.secret
# Não pode ficar vazio: o compose da raiz exige a variável (${SECRET_KEY_BASE:?}) mesmo no dev.
SECRET_KEY_BASE=dev-nao-use-em-producao
# >= 32 bytes; token do websocket do terminal. Gere: mix phx.gen.secret 32
AUTH_SECRET_KEY=
# Tempo (ms) que a partida de pong sobrevive sem jogador
IDLE_GRACE_MS=30000
# Opcional: versão do release (mix.exs)
PORTFOLIO_VERSION=

# ─── RabbitMQ ────────────────────────────────────────────────────────
# Sem "/" no final: "amqp://host/" = vhost vazio na spec AMQP
RABBITMQ_URL=amqp://guest:guest@rabbitmq
# Usados só pelo docker-compose.yml da raiz
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── IA do Pong (Python) ─────────────────────────────────────────────
HEARTBEAT_FILE=/tmp/ai-heartbeat
TRAIN_SERVER_PORT=4001

# ─── Frontend (build) ────────────────────────────────────────────────
# Opcionais: sem eles o vite.config.js monta a versão via package.json + git
VITE_APP_VERSION=
SOURCE_COMMIT=

# ─── Constantes do jogo ──────────────────────────────────────────────
# Ficam em envs/.env.pong (versionado). Backend, IA e Vite leem de lá:
# GAME_WIDTH GAME_HEIGHT PADDLE_WIDTH PADDLE_HEIGHT PADDLE_SPEED BALL_RADIUS
# PLAYER_X AI_X WIN_SCORE TICK_MS MAX_BALL_SPEED BALL_ACCEL MAX_STEPS

# ─── Compose ─────────────────────────────────────────────────────────
# Porta do frontend da stack de produção, publicada só em 127.0.0.1
FRONTEND_PORT=9001

# ── Ambiente de desenvolvimento (.devcontainer) ───────────────────────
# Só o container dev lê isto; produção ignora.
# Caminho absoluto do repositório no host — o projeto é montado no mesmo
# caminho dentro do dev. Na raiz do repo:  echo "PROJECT_DIR=$PWD" >> .env
PROJECT_DIR=
# UID/GID do teu usuário (id -u / id -g): arquivo criado no dev nasce com esse
# dono no host. Não é UID/GID porque no bash UID é somente leitura e quebraria
# o `. ./.env`.
DEV_UID=1000
DEV_GID=1000
# GID do grupo docker do host:  stat -c %g /var/run/docker.sock
DOCKER_GID=984
