# ─── Backend Elixir (Phoenix) ─────────────────────────────────────────
PORT=4000
# >= 64 bytes; abaixo disso cai no fallback de dev (em prod dá raise). Gere: mix phx.gen.secret
SECRET_KEY_BASE=
# >= 32 bytes; token do websocket do terminal. Gere: mix phx.gen.secret 32
AUTH_SECRET_KEY=
# Tempo (ms) que a partida de pong sobrevive sem jogador
IDLE_GRACE_MS=30000
# Opcional: versão do release (mix.exs)
PORTFOLIO_VERSION=

# ─── RabbitMQ ────────────────────────────────────────────────────────
# Sem "/" no final: "amqp://host/" = vhost vazio na spec AMQP
RABBITMQ_URL=amqp://guest:guest@rabbitmq
# Usados só pelo docker/production/docker-compose.yml
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── IA do Pong (Python) ─────────────────────────────────────────────
HEARTBEAT_FILE=/tmp/ai-heartbeat
TRAIN_SERVER_PORT=4001

# ─── Frontend (build) ────────────────────────────────────────────────
# Opcionais: sem eles o vite.config.js monta a versão via package.json + git
VITE_APP_VERSION=
SOURCE_COMMIT=

# ─── Constantes do jogo ──────────────────────────────────────────────
# Ficam em envs/.env.pong (versionado). Backend, IA e Vite leem de lá:
# GAME_WIDTH GAME_HEIGHT PADDLE_WIDTH PADDLE_HEIGHT PADDLE_SPEED BALL_RADIUS
# PLAYER_X AI_X WIN_SCORE TICK_MS MAX_BALL_SPEED BALL_ACCEL MAX_STEPS
